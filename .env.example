# ─────────────────────────────────────────────────────────────
#  gametrans — کلیدهای API
#
#  این فایل را به  .env  کپی کنید (بدون هیچ پسوند دیگری):
#      copy .env.example .env
#
#  بعد کلید خود را جلوی نام آن بگذارید و فایل را ذخیره کنید.
#  علامت # اول خط یعنی آن خط غیرفعال است — برای فعال کردن حذفش کنید.
#
#  ⚠️  فایل .env در .gitignore هست، پس کلید شما هیچ‌وقت روی گیت‌هاب نمی‌رود.
#      کلید را برای کسی نفرستید و در اسکرین‌شات نگذارید.
# ─────────────────────────────────────────────────────────────


# Gemini — بهترین کیفیت فارسی بین گزینه‌های رایگان
# کلید رایگان: https://aistudio.google.com/apikey
# کلیدهای جدید با  AQ.  شروع می‌شوند (کلیدهای قدیمی با AIza). هر دو کار می‌کنند.
GEMINI_API_KEY=


# Groq — سریع‌ترین، و سقف روزانه‌اش حدود ۱۰ برابر Gemini است
# کلید رایگان: https://console.groq.com/keys
# کلید با gsk_ شروع می‌شود.
GROQ_API_KEY=


# Anthropic — بهترین کیفیت فارسی در کل، ولی پولی (اختیاری)
# برای فعال شدن باید در config.toml هم enabled = true شود.
# ANTHROPIC_API_KEY=


# Ollama لوکال کلید نمی‌خواهد — فقط در config.toml مقدار
# enabled را برای ollama-local برابر true بگذارید.
